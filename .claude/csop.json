{
  // CSOP project config -- the model other projects copy and edit.
  // Overrides code-default properties per discipline (keyed by codename); only a
  // discipline's overridable properties are honored -- identity/description live
  // in code. Parsed as JSON-with-comments (// and /* */, trailing commas ok).

  "iso": {
    "home": "scratch/iso/"           // where iso-trees must live (never /tmp)
  },

  "hacc": {
    "default_enabled": true,         // set false to opt this project out
    // the only git subcommands the agent may run; everything else a human runs:
    "read_list": ["log", "status", "diff", "show", "blame", "describe", "shortlog", "rev-parse", "rev-list", "ls-files", "ls-tree", "ls-remote", "cat-file", "for-each-ref", "check-ignore", "grep", "add", "worktree add", "worktree list"],
  },

  "scratch": {
    "default_enabled": true,
    "home": "scratch/",              // move content here instead of deleting it
    // "deny_patterns": [ /* regexes for destructive commands; see code default */ ],
    // "reminder": "…"                // appended to the built-in reminder (not replaced)
  },

  "pro": {
    "default_enabled": true          // dogfood: promotion active on this repo
  },

  "techwrite": {
    "default_enabled": true          // this repo is mostly prose; implies hyg
  },

  // the family config lives under `tdd`; `py-tdd` inherits it and adds pytest regexes
  "tdd": {
    "runner_patterns": ["\\bpython[0-9.]*\\s+-m\\s+unittest\\b", "\\bmake\\s+(?:check|ci|validate)\\b"],
    "suite_roots": ["tests.test_csop"],   // the one test module is the whole suite
    "example": "python3 -m unittest -k <name> tests.test_csop"
  },
  "py-tdd": {
    "default_enabled": true          // dogfood: hypothesis-first, suite runs ask
  },

  "freeze": {
    "default_enabled": true,
    "frozen": [
      {
        "path": ".claude/commands/",
        "mode": "no-touch",
        "why": "generated by `make init` from commands/, gitignored, wiped by `make clean`",
        "use": "commands/"
      }
    ]
  },

  // placeholder stages, permissive writable so nothing is restricted yet; iterate later
  "stages": {
    "spike": {
      "default_stage": true,
      "globs": ["scratch/**"],
      "writable": ["**"]
    },
    "core": {
      "globs": ["hooks/**", "tests/**"],
      "from": ["spike"],
      "writable": ["**"],
      "pre":  { "text": "core edit: prototype risky changes in scratch/iso first, then promote", "action": "nudge" },
      "post": "core changed: run make test"
    }
  },
}

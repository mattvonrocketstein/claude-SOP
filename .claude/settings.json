{
  "permissions": {
    "allow": [
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\")",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" enable *)",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" list*)",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" catalog*)",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" help*)",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" stage*)",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" promote*)",
      "Bash(python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop.py\" demote*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-session-reset.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-nudge.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-bashverb.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-git.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-scratch.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-entrypoints.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-racc.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-hyg.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-techwrite.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-idiom.py\"" }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-pathblock.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-isowrite.py\"" }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-disarm.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-selfprotect.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-mem.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-promotion.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-react-ftypes.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-report-mem.py\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-gate-promotion.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/csop-modeline.py\"" }
        ]
      }
    ]
  }
}

{
  // CSOP project config template. Copy to <your-project>/.claude/csop.json and edit.
  // Keys are discipline codenames; each block overrides that discipline's code
  // defaults (hooks/disciplines.py). Only a discipline's overridable properties
  // are honored. Parsed as JSON-with-comments (// and /* */, trailing commas ok).
  // Omit a property to keep its code default; list the codenames with `/sop catalog`.

  "hacc": {
    "default_enabled": true           // git is read-only for the agent; false opts out
    // "read_list": [ ... ]           // replaces the built-in git read allowlist
  },

  "scratch": {
    "default_enabled": true,
    "home": "scratch/"                // where content goes instead of being deleted
  },

  "iso": {
    "home": "scratch/iso/"            // where iso-trees must live (never /tmp)
  },

  "hyg": {
    "prose_exts": ["mdx"]             // appends to the defaults rather than replacing
  },

  "tdd": {
    "example": "pytest tests/test_x.py::test_name"   // the narrow run the nudge suggests
  },

  "freeze": {
    "default_enabled": false,
    "frozen": [
      {
        "path": "dist/",
        "mode": "no-touch",           // no-write | no-touch | no-restructure
        "why": "build output, regenerated by make build",
        "use": "src/"
      }
    ]
  },

  // optional: named stages, each able to relax or tighten disciplines while current
  "stages": {
    "draft": {
      "default_stage": true,
      "disciplines": { "hyg": { "action": "nudge" } }
    },
    "polish": {
      "from": ["draft"],
      "disciplines": { "hyg": { "action": "block" } }
    }
  }
}

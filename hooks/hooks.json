{
  "SessionStart": [
    {
      "matcher": "startup|clear|resume",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-session-reset.py\"" }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-nudge.py\"" }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-bashverb.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-git.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-scratch.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-entrypoints.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-racc.py\"" }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-hyg.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-techwrite.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-idiom.py\"" }
      ]
    },
    {
      "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|Bash",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-pathblock.py\"" }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-isowrite.py\"" }
      ]
    },
    {
      "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-disarm.py\"" }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-selfprotect.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-dreamwrite.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-mem.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-promotion.py\"" }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-react-ftypes.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-report-mem.py\"" },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-gate-promotion.py\"" }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/csop-modeline.py\"" }
      ]
    }
  ]
}
